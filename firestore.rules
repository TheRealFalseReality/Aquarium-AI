rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function postDoc(postId) {
      return get(/databases/$(database)/documents/posts/$(postId));
    }

    function commentDoc(postId, commentId) {
      return get(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId));
    }

    function postMatchesNotificationTarget(postId, ownerUid, postType, postTitle) {
      return exists(/databases/$(database)/documents/posts/$(postId)) &&
          postDoc(postId).data.userId == ownerUid &&
          postDoc(postId).data.type == postType &&
          postDoc(postId).data.title == postTitle;
    }

    function commentMatchesActorAndPreview(postId, commentId, actorUid, previewText) {
      return exists(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId)) &&
          commentDoc(postId, commentId).data.userId == actorUid &&
          commentDoc(postId, commentId).data.body == previewText;
    }

    // Users can read/write their own profile
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Per-user community bookmarks.
      match /bookmarks/{postId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Per-user community interaction notifications.
      // Only the owner can read/update/delete.
      // Create is allowed only when the actor can prove the interaction happened.
      match /community_notifications/{notificationId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null &&
            request.resource.data.actorUserId == request.auth.uid &&
            request.resource.data.postId is string &&
            request.resource.data.postTitle is string &&
            request.resource.data.interactionType is string &&
            request.resource.data.postType is string &&
            request.resource.data.previewText is string &&
            request.resource.data.read is bool &&
            request.resource.data.createdAt is timestamp &&
            exists(/databases/$(database)/documents/posts/$(request.resource.data.postId)) &&
            postMatchesNotificationTarget(
              request.resource.data.postId,
              uid,
              request.resource.data.postType,
              request.resource.data.postTitle
            ) &&
            request.resource.data.interactionType in ['like', 'bookmark', 'comment'] &&
            (
              (request.resource.data.interactionType == 'like' &&
                request.resource.data.previewText == request.resource.data.postTitle &&
                exists(/databases/$(database)/documents/posts/$(request.resource.data.postId)/likes/$(request.auth.uid))) ||
              (request.resource.data.interactionType == 'bookmark' &&
                request.resource.data.previewText == request.resource.data.postTitle &&
                exists(/databases/$(database)/documents/users/$(request.auth.uid)/bookmarks/$(request.resource.data.postId))) ||
              (request.resource.data.interactionType == 'comment' &&
                request.resource.data.commentId is string &&
                exists(/databases/$(database)/documents/posts/$(request.resource.data.postId)/comments/$(request.resource.data.commentId)) &&
                commentMatchesActorAndPreview(
                  request.resource.data.postId,
                  request.resource.data.commentId,
                  request.auth.uid,
                  request.resource.data.previewText
                ))
            );
      }
    }

    // Cloud backup documents for the signed-in owner.
    match /users/{uid}/backups/{backupId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Tank photo blobs stored alongside cloud backups.
      match /photos/{photoDocId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Anyone signed in (including anonymous) can read posts
    // Only the author can delete their own post
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      // Per-user like tracking.
      // Any signed-in user can read like documents (needed by hasLiked).
      // Each user may only write (create/delete) their own like document,
      // which enforces the one-like-per-user rule and allows unliking.
      // Authors can like their own posts — no restriction on that.
      match /likes/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Comments sub-collection
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
      }
    }
  }
}
