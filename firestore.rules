rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isPostOwner() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }

    function isValidLikeCounterUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likes',
          ]) &&
          request.resource.data.likes is int &&
          (request.resource.data.likes == resource.data.likes + 1 ||
              request.resource.data.likes == resource.data.likes - 1);
    }

    function isValidCommentCounterUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'commentCount',
          ]) &&
          request.resource.data.commentCount is int &&
          (request.resource.data.commentCount == resource.data.commentCount + 1 ||
              request.resource.data.commentCount ==
                  resource.data.commentCount - 1);
    }

    // Users can read/write their own profile
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Anyone signed in (including anonymous) can read posts
    // Only the author can delete their own post
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isPostOwner() ||
          (isSignedIn() &&
              (isValidLikeCounterUpdate() || isValidCommentCounterUpdate()));
      allow delete: if isPostOwner();

      // Per-user like tracking.
      // Any signed-in user can read like documents (needed by hasLiked).
      // Each user may only write (create/delete) their own like document,
      // which enforces the one-like-per-user rule and allows unliking.
      // Authors can like their own posts — no restriction on that.
      match /likes/{userId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == userId;
      }

      // Comments sub-collection
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
      }
    }
  }
}
