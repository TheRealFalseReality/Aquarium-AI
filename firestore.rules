rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Cloud backup documents for the signed-in owner.
    match /users/{uid}/backups/{backupId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Tank photo blobs stored alongside cloud backups.
      match /photos/{photoDocId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Anyone signed in (including anonymous) can read posts
    // Only the author can delete their own post
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      // Per-user like tracking.
      // Any signed-in user can read like documents (needed by hasLiked).
      // Each user may only write (create/delete) their own like document,
      // which enforces the one-like-per-user rule and allows unliking.
      // Authors can like their own posts — no restriction on that.
      match /likes/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Comments sub-collection
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
      }
    }
  }
}
